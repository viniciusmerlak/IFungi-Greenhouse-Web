{
  "name": "ifungi-ai-desktop",
  "version": "1.0.2",
  "description": "IFungi AI Desktop - Local AI agent for mushroom greenhouse optimization",
  "author": "IFungi AI Desktop Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciusmerlak/IFungi-Greenhouse-Web.git"
  },
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "tsc && vite build",
    "release:local": "electron-builder --win --x64 --publish=never",
    "release:ci": "electron-builder --win --x64 --publish=always",
    "pack:win": "electron-builder --win --x64 --publish=never"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@google/generative-ai": "^0.21.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "electron-updater": "^6.8.3",
    "electron-log": "^5.4.4",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^26.0.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ifungi.ai-desktop",
    "productName": "IFungi AI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/electron-log/**",
      "node_modules/electron-updater/**",
      "node_modules/fs-extra/**",
      "node_modules/@google/genai/**",
      "node_modules/@google/generative-ai/**",
      "node_modules/firebase/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "viniciusmerlak",
        "repo": "IFungi-Greenhouse-Web",
        "releaseType": "release"
      }
    ]
  }
}
