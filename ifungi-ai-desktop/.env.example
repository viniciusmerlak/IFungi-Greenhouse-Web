# IFungi AI Desktop Environment Variables
# Copie este arquivo para .env e preencha os valores

# ─────────────────────────────────────────────────────────────────
# OBRIGATÓRIO — Gemini API Key (https://makersuite.google.com/app/apikey)
# ─────────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────
# OBRIGATÓRIO PARA OTA — GitHub Personal Access Token
# Gere em: GitHub → Settings → Developer Settings → Personal Access Tokens
# Permissão necessária: repo (leitura + escrita em releases)
# ─────────────────────────────────────────────────────────────────
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
# OPCIONAL — Firebase Config (sobrescreve os valores padrão do web app)
# ─────────────────────────────────────────────────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
