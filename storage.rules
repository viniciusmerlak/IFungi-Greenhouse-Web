rules_version = '2';

// Regras do Cloud Storage para o IFungi.
// O bucket eh usado como buffer temporario do .bin durante a publicacao OTA:
// o navegador escreve em ota-staging/{greenhouseId}/{ts}.bin, o GitHub Actions
// baixa via download URL publica e o navegador remove apos a release ser
// publicada.
service firebase.storage {
  match /b/{bucket}/o {
    match /ota-staging/{greenhouseId}/{file} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
